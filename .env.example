# Copy to .env. Generate SESSION_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
COOKIE_SECURE=false
DATABASE_URL=postgresql+asyncpg://delivery:delivery@localhost:5432/delivery
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://delivery:delivery@localhost:5672/
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
QDRANT_URL=http://localhost:6333
CBR_URL=https://www.cbr-xml-daily.ru/daily_json.js
WORKER_CONCURRENCY=16
LOG_LEVEL=INFO
